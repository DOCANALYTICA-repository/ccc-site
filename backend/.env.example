# Local dev uses docker-compose. Production uses Supabase Supavisor.
#
# On Vercel, DATABASE_URL MUST be the transaction-mode pooler (port 6543) with
# ?pgbouncer=true&connection_limit=1 — every warm lambda opens its own Prisma
# pool, and direct connections (port 5432) exhaust Postgres under concurrency.
# DIRECT_URL stays direct: `prisma migrate deploy` needs a session connection.
DATABASE_URL="postgresql://ccc:ccc_dev_pw@localhost:5433/ccc_event_registry?schema=public"
DIRECT_URL="postgresql://ccc:ccc_dev_pw@localhost:5433/ccc_event_registry?schema=public"

# openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-real-32-byte-secret"
CHECKIN_SECRET="replace-me-with-a-separate-32-byte-secret"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_..."
SUPABASE_JWT_SECRET="replace-with-imported-shared-signing-secret"
SUPABASE_COURSE_BUCKET="course-resources"

# Local only — Vercel is serverless and ignores this.
PORT=4000

# Comma-separated. Gates CORS and every non-GET request, and the FIRST entry is
# what the printed POC check-in QR points at — put the canonical domain first.
FRONTEND_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"

DEFAULT_PHONE_REGION="IN"

# Never set this on Vercel; it sets NODE_ENV=production itself. The session
# cookie only becomes SameSite=None; Secure — which cross-domain login requires
# — when this reads "production".
NODE_ENV="development"
