generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [citext]
}

enum Role {
  ADMIN
  STAFF
  MEMBER
  GUEST
}

enum ContactSource {
  MANUAL
  IMPORT
  WALK_IN
}

enum EventStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum InvitationStatus {
  UNCONFIRMED
  CONFIRMED
  DECLINED
  ARRIVED_IN_CAMPUS
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  REMOVED
}

enum CatalogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SurveyStatus {
  DRAFT
  OPEN
  CLOSED
}

enum NotificationType {
  EVENT_INVITATION
  CONNECTION_REQUEST
  CONNECTION_ACCEPTED
  NEW_MESSAGE
  CATALOG_ACCESS
  SURVEY_OPENED
}

model User {
  id                 String    @id @default(uuid())
  email              String?   @unique @db.Citext
  phone              String?   @unique
  name               String
  passwordHash       String?   @map("password_hash")
  role               Role      @default(STAFF)
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  isActive           Boolean   @default(true) @map("is_active")
  tokenVersion       Int       @default(0) @map("token_version")
  lastLoginAt        DateTime? @map("last_login_at")
  contactId          String?   @unique @map("contact_id")
  contact            Contact?  @relation("ContactAccount", fields: [contactId], references: [id], onDelete: SetNull)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  profile                NetworkProfile?
  invitesCreated         UserInvite[]              @relation("InviteCreatedBy")
  invitesReceived        UserInvite[]              @relation("InviteForUser")
  contactsCreated        Contact[]                 @relation("ContactCreatedBy")
  eventsCreated          Event[]                   @relation("EventCreatedBy")
  invitationsAdded       EventInvitation[]         @relation("InvitationAddedBy")
  statusChanges          EventInvitation[]         @relation("StatusUpdatedBy")
  historyEntries         InvitationStatusHistory[] @relation("HistoryChangedBy")
  importBatches          ImportBatch[]             @relation("ImportUploadedBy")
  auditLogEntries        AuditLog[]                @relation("AuditActor")
  connectionsRequested   Connection[]              @relation("ConnectionRequester")
  connectionsReceived    Connection[]              @relation("ConnectionRecipient")
  blocksCreated          UserBlock[]               @relation("Blocker")
  blocksReceived         UserBlock[]               @relation("Blocked")
  conversations          ConversationParticipant[]
  messages               Message[]
  notifications          Notification[]
  accessGroupMemberships AccessGroupMember[]
  catalogGrants          CatalogGrant[]
  surveyResponses        SurveyResponse[]
  checkInSessionsStarted EventCheckInSession[]     @relation("CheckInStartedBy")

  @@index([role, isActive])
  @@map("users")
}

model UserInvite {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  targetUser User      @relation("InviteForUser", fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash")
  purpose    String    @default("INVITE")
  expiresAt  DateTime  @map("expires_at")
  acceptedAt DateTime? @map("accepted_at")
  createdBy  String    @map("created_by")
  creator    User      @relation("InviteCreatedBy", fields: [createdBy], references: [id])
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("user_invites")
}

model LoginAttempt {
  id                  String   @id @default(uuid())
  identifierAttempted String   @map("identifier_attempted") @db.Citext
  ip                  String
  succeeded           Boolean
  at                  DateTime @default(now())

  @@index([identifierAttempted, at])
  @@index([ip, at])
  @@map("login_attempts")
}

model Contact {
  id           String            @id @default(uuid())
  fullName     String            @map("full_name")
  organization String?
  designation  String?
  profileUrl   String?           @map("profile_url")
  email        String?           @db.Citext
  altEmail     String?           @map("alt_email") @db.Citext
  phone        String?
  altPhone     String?           @map("alt_phone")
  phoneRaw     String?           @map("phone_raw")
  dietaryNotes String?           @map("dietary_notes")
  notes        String?
  source       ContactSource     @default(MANUAL)
  createdBy    String?           @map("created_by")
  creator      User?             @relation("ContactCreatedBy", fields: [createdBy], references: [id])
  account      User?             @relation("ContactAccount")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  deletedAt    DateTime?         @map("deleted_at")
  tags         ContactTag[]
  invitations  EventInvitation[]

  @@index([email])
  @@index([phone])
  @@map("contacts")
}

model Tag {
  id        String       @id @default(uuid())
  name      String       @unique
  createdAt DateTime     @default(now()) @map("created_at")
  contacts  ContactTag[]

  @@map("tags")
}

model ContactTag {
  contactId String  @map("contact_id")
  tagId     String  @map("tag_id")
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@map("contact_tags")
}

model Event {
  id              String                @id @default(uuid())
  name            String
  description     String?
  venue           String?
  startAt         DateTime?             @map("start_at")
  endAt           DateTime?             @map("end_at")
  timezone        String                @default("Asia/Kolkata")
  status          EventStatus           @default(DRAFT)
  createdBy       String?               @map("created_by")
  creator         User?                 @relation("EventCreatedBy", fields: [createdBy], references: [id])
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  invitations     EventInvitation[]
  importBatches   ImportBatch[]
  checkInSessions EventCheckInSession[]
  survey          EventSurvey?

  @@map("events")
}

model EventInvitation {
  id               String                    @id @default(uuid())
  eventId          String                    @map("event_id")
  contactId        String                    @map("contact_id")
  event            Event                     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  contact          Contact                   @relation(fields: [contactId], references: [id], onDelete: Restrict)
  arrivalAt        DateTime?                 @map("arrival_at")
  departureAt      DateTime?                 @map("departure_at")
  status           InvitationStatus          @default(UNCONFIRMED)
  respondedAt      DateTime?                 @map("responded_at")
  statusUpdatedAt  DateTime?                 @map("status_updated_at")
  statusUpdatedBy  String?                   @map("status_updated_by")
  statusUpdater    User?                     @relation("StatusUpdatedBy", fields: [statusUpdatedBy], references: [id])
  addedDuringEvent Boolean                   @default(false) @map("added_during_event")
  travelMode       String?                   @map("travel_mode")
  accommodation    String?
  notes            String?
  addedBy          String?                   @map("added_by")
  adder            User?                     @relation("InvitationAddedBy", fields: [addedBy], references: [id])
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")
  history          InvitationStatusHistory[]
  surveyResponse   SurveyResponse?

  @@unique([eventId, contactId])
  @@index([eventId, status])
  @@map("event_invitations")
}

model InvitationStatusHistory {
  id           String            @id @default(uuid())
  invitationId String            @map("invitation_id")
  invitation   EventInvitation   @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  fromStatus   InvitationStatus? @map("from_status")
  toStatus     InvitationStatus  @map("to_status")
  changedBy    String?           @map("changed_by")
  changer      User?             @relation("HistoryChangedBy", fields: [changedBy], references: [id])
  changedAt    DateTime          @default(now()) @map("changed_at")

  @@index([invitationId])
  @@map("invitation_status_history")
}

model EventCheckInSession {
  id        String    @id @default(uuid())
  eventId   String    @map("event_id")
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  isActive  Boolean   @default(true) @map("is_active")
  startedBy String    @map("started_by")
  starter   User      @relation("CheckInStartedBy", fields: [startedBy], references: [id])
  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")

  @@index([eventId, isActive])
  @@map("event_check_in_sessions")
}

model NetworkProfile {
  userId           String   @id @map("user_id")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName      String   @map("display_name")
  organization     String?
  designation      String?
  headline         String?
  bio              String?
  publicEmail      String?  @map("public_email") @db.Citext
  linkedInUrl      String?  @map("linkedin_url")
  avatarPath       String?  @map("avatar_path")
  discoverable     Boolean  @default(false)
  shareDesignation Boolean  @default(false) @map("share_designation")
  shareHeadline    Boolean  @default(false) @map("share_headline")
  shareBio         Boolean  @default(false) @map("share_bio")
  shareEmail       Boolean  @default(false) @map("share_email")
  shareLinkedIn    Boolean  @default(false) @map("share_linkedin")
  shareAvatar      Boolean  @default(false) @map("share_avatar")
  adminVisible     Boolean  @default(true) @map("admin_visible")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([discoverable, adminVisible])
  @@map("network_profiles")
}

model Connection {
  id           String           @id @default(uuid())
  pairKey      String           @unique @map("pair_key")
  requesterId  String           @map("requester_id")
  requester    User             @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  recipientId  String           @map("recipient_id")
  recipient    User             @relation("ConnectionRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  status       ConnectionStatus @default(PENDING)
  respondedAt  DateTime?        @map("responded_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  conversation Conversation?

  @@index([requesterId, status])
  @@index([recipientId, status])
  @@map("connections")
}

model UserBlock {
  blockerId String   @map("blocker_id")
  blockedId String   @map("blocked_id")
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([blockerId, blockedId])
  @@map("user_blocks")
}

model Conversation {
  id           String                    @id @default(uuid())
  connectionId String                    @unique @map("connection_id")
  connection   Connection                @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  createdAt    DateTime                  @default(now()) @map("created_at")
  updatedAt    DateTime                  @updatedAt @map("updated_at")
  participants ConversationParticipant[]
  messages     Message[]

  @@map("conversations")
}

model ConversationParticipant {
  conversationId String       @map("conversation_id")
  userId         String       @map("user_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?    @map("last_read_at")

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String       @map("sender_id")
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Restrict)
  body           String
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Notification {
  id         String           @id @default(uuid())
  userId     String           @map("user_id")
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType
  title      String
  body       String?
  entityType String?          @map("entity_type")
  entityId   String?          @map("entity_id")
  readAt     DateTime?        @map("read_at")
  createdAt  DateTime         @default(now()) @map("created_at")

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model Program {
  id          String          @id @default(uuid())
  name        String
  code        String          @unique
  description String?
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  catalogs    CourseCatalog[]

  @@map("programs")
}

model CourseCatalog {
  id           String         @id @default(uuid())
  programId    String         @map("program_id")
  program      Program        @relation(fields: [programId], references: [id], onDelete: Restrict)
  title        String
  academicYear String         @map("academic_year")
  version      String
  description  String?
  status       CatalogStatus  @default(DRAFT)
  publishedAt  DateTime?      @map("published_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  courses      Course[]
  grants       CatalogGrant[]

  @@unique([programId, academicYear, version])
  @@index([status, academicYear])
  @@map("course_catalogs")
}

model Course {
  id          String           @id @default(uuid())
  catalogId   String           @map("catalog_id")
  catalog     CourseCatalog    @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  code        String
  title       String
  semester    Int
  credits     Int?
  description String?
  position    Int              @default(0)
  modules     CourseModule[]
  resources   CourseResource[]

  @@unique([catalogId, code])
  @@index([catalogId, semester, position])
  @@map("courses")
}

model CourseModule {
  id       String @id @default(uuid())
  courseId String @map("course_id")
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title    String
  content  String
  position Int    @default(0)

  @@index([courseId, position])
  @@map("course_modules")
}

model CourseResource {
  id           String   @id @default(uuid())
  courseId     String   @map("course_id")
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title        String
  resourceType String   @map("resource_type")
  storagePath  String?  @map("storage_path")
  externalUrl  String?  @map("external_url")
  mimeType     String?  @map("mime_type")
  sizeBytes    Int?     @map("size_bytes")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([courseId])
  @@map("course_resources")
}

model AccessGroup {
  id          String              @id @default(uuid())
  name        String              @unique
  description String?
  createdAt   DateTime            @default(now()) @map("created_at")
  members     AccessGroupMember[]
  grants      CatalogGrant[]

  @@map("access_groups")
}

model AccessGroupMember {
  groupId String      @map("group_id")
  userId  String      @map("user_id")
  group   AccessGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
  @@map("access_group_members")
}

model CatalogGrant {
  id        String        @id @default(uuid())
  catalogId String        @map("catalog_id")
  catalog   CourseCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  userId    String?       @map("user_id")
  user      User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId   String?       @map("group_id")
  group     AccessGroup?  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now()) @map("created_at")

  @@unique([catalogId, userId])
  @@unique([catalogId, groupId])
  @@index([userId])
  @@index([groupId])
  @@map("catalog_grants")
}

model SurveyTemplate {
  id           String                   @id @default(uuid())
  name         String
  description  String?
  createdAt    DateTime                 @default(now()) @map("created_at")
  updatedAt    DateTime                 @updatedAt @map("updated_at")
  questions    SurveyTemplateQuestion[]
  eventSurveys EventSurvey[]

  @@map("survey_templates")
}

model SurveyTemplateQuestion {
  id         String         @id @default(uuid())
  templateId String         @map("template_id")
  template   SurveyTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  prompt     String
  position   Int            @default(0)

  @@index([templateId, position])
  @@map("survey_template_questions")
}

model EventSurvey {
  id         String                @id @default(uuid())
  eventId    String                @unique @map("event_id")
  event      Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  templateId String?               @map("template_id")
  template   SurveyTemplate?       @relation(fields: [templateId], references: [id], onDelete: SetNull)
  title      String
  status     SurveyStatus          @default(DRAFT)
  openedAt   DateTime?             @map("opened_at")
  closedAt   DateTime?             @map("closed_at")
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")
  questions  EventSurveyQuestion[]
  responses  SurveyResponse[]

  @@map("event_surveys")
}

model EventSurveyQuestion {
  id       String         @id @default(uuid())
  surveyId String         @map("survey_id")
  survey   EventSurvey    @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  prompt   String
  position Int            @default(0)
  answers  SurveyAnswer[]

  @@index([surveyId, position])
  @@map("event_survey_questions")
}

model SurveyResponse {
  id           String          @id @default(uuid())
  surveyId     String          @map("survey_id")
  survey       EventSurvey     @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  invitationId String          @unique @map("invitation_id")
  invitation   EventInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  userId       String          @map("user_id")
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  submittedAt  DateTime        @default(now()) @map("submitted_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  answers      SurveyAnswer[]

  @@index([surveyId, userId])
  @@map("survey_responses")
}

model SurveyAnswer {
  responseId String              @map("response_id")
  questionId String              @map("question_id")
  response   SurveyResponse      @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question   EventSurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  value      Boolean

  @@id([responseId, questionId])
  @@map("survey_answers")
}

model ImportBatch {
  id           String   @id @default(uuid())
  filename     String
  uploadedBy   String?  @map("uploaded_by")
  uploader     User?    @relation("ImportUploadedBy", fields: [uploadedBy], references: [id])
  eventId      String?  @map("event_id")
  event        Event?   @relation(fields: [eventId], references: [id])
  totalRows    Int      @map("total_rows")
  createdCount Int      @default(0) @map("created_count")
  updatedCount Int      @default(0) @map("updated_count")
  skippedCount Int      @default(0) @map("skipped_count")
  errorCount   Int      @default(0) @map("error_count")
  errors       Json?
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("import_batches")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?  @map("actor_id")
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  diff       Json?
  ip         String?
  userAgent  String?  @map("user_agent")
  at         DateTime @default(now())

  @@index([actorId, at])
  @@index([entityType, entityId])
  @@map("audit_log")
}
