# Dev: leave unset — Vite's proxy (vite.config.ts) forwards /api to
# http://localhost:4000 same-origin, so no CORS/cookie complications.
#
# Production: the deployed backend's URL, e.g. https://ccc-registry-api.vercel.app/api
VITE_API_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_COURSE_BUCKET=course-resources
